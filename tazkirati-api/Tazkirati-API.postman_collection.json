{
  "info": {
    "_postman_id": "8c21d1a0-5b74-4f6a-9e11-3d7a9c5f1021",
    "name": "Tazkirati API",
    "description": "API testing collection for Tazkirati event ticketing system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "List Published Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const events = body.data || [];",
                  "pm.test('Events are returned', function () { pm.expect(events.length).to.be.above(0); });",
                  "if (events.length > 0) { pm.environment.set('event_id', events[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Event Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/events/{{event_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const event = body.data || body;",
                  "const types = event.ticket_types || [];",
                  "pm.test('Ticket types are returned', function () { pm.expect(types.length).to.be.above(0); });",
                  "if (types.length > 0) { pm.environment.set('ticket_type_id', types[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Remaining Tickets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/events/{{event_id}}/remaining-tickets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Customer Bookings",
      "item": [
        {
          "name": "Create Booking For Confirmation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"ticket_type_id\": {{ticket_type_id}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking created with status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "const booking = body.data || body;",
                  "pm.test('Booking ID exists', function () { pm.expect(booking.id).to.exist; });",
                  "if (booking.id) { pm.environment.set('booking_id', booking.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm Booking Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/confirm"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking payment confirmed', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Booking For Cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"ticket_type_id\": {{ticket_type_id}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Second booking created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "const booking = body.data || body;",
                  "if (booking.id) { pm.environment.set('cancel_booking_id', booking.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Temporary Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/bookings/{{cancel_booking_id}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Temporary booking cancelled', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Organizer",
      "item": [
        {
          "name": "Cancel Organizer Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizer_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/v1/organizer/events/{{organizer_event_id}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Organizer event cancelled', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}